{
  "name": "crema",
  "productName": "Crema",
  "version": "0.1.0",
  "description": "Turn documents into AI summaries and flashcards.",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
